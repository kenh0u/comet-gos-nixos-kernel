 =?UTF-8?q?=20vendor=20module=20=E3=81=AE=20sysfs=20show=20CFI=20=E4=B8=8D?=
 =?UTF-8?q?=E4=B8=80=E8=87=B4=E3=82=92=E5=AF=9B=E5=AE=B9=E5=8C=96?=
