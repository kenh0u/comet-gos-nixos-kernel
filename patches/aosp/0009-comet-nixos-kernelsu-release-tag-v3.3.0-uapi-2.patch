-
-    if (ksu_syscall_table == NULL)
-        return;
-    if (nr < 0 || nr >= __NR_syscalls)
-        return;
-
-    mutex_lock(&hooked_entries_lock);
-
-    for (i = 0; i < hooked_count; i++) {
-        if (hooked_entries[i].nr == nr) {
-            patch_syscall_table(nr, hooked_entries[i].orig);
