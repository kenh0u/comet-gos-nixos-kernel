-    # keep sorted
-    "drivers/block/zram/zram.ko",
+        "drivers/block/zram/zram.ko",
     "drivers/bluetooth/btbcm.ko",
+    "drivers/bluetooth/btintel.ko",
+    "drivers/bluetooth/btmtk.ko",
     "drivers/bluetooth/btqca.ko",
+    "drivers/bluetooth/btrtl.ko",
     "drivers/bluetooth/btsdio.ko",
+    "drivers/bluetooth/btusb.ko",
     "drivers/bluetooth/hci_uart.ko",
     "drivers/net/can/dev/can-dev.ko",
     "drivers/net/can/slcan/slcan.ko",
+    "drivers/net/can/usb/esd_usb.ko",
+    "drivers/net/can/usb/etas_es58x/etas_es58x.ko",
+    "drivers/net/can/usb/gs_usb.ko",
+    "drivers/net/can/usb/kvaser_usb/kvaser_usb.ko",
+    "drivers/net/can/usb/mcba_usb.ko",
+    "drivers/net/can/usb/peak_usb/peak_usb.ko",
+    "drivers/net/can/usb/ucan.ko",
+    "drivers/net/can/usb/usb_8dev.ko",
     "drivers/net/can/vcan.ko",
     "drivers/net/mii.ko",
+    "drivers/net/phy/smsc.ko",
     "drivers/net/ppp/bsd_comp.ko",
     "drivers/net/ppp/ppp_deflate.ko",
     "drivers/net/ppp/ppp_generic.ko",
@@ -29,15 +41,68 @@ _COMMON_GKI_MODULES_LIST = [
     "drivers/net/usb/ax88179_178a.ko",
     "drivers/net/usb/cdc_eem.ko",
     "drivers/net/usb/cdc_ether.ko",
+    "drivers/net/usb/cdc_mbim.ko",
     "drivers/net/usb/cdc_ncm.ko",
+    "drivers/net/usb/qmi_wwan.ko",
