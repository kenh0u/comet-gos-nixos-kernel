+    "drivers/net/usb/smsc95xx.ko",
     "drivers/net/usb/usbnet.ko",
     "drivers/net/wwan/wwan.ko",
     "drivers/usb/class/cdc-acm.ko",
+    "drivers/usb/class/cdc-wdm.ko",
