+#!/bin/bash
+# comet-nixos(2026-11-27): kleaf hermetic-tools の cp は toybox で、btrfs の
+# system.posix_acl_access に未マップ uid があると cp -p の setxattr が EINVAL。
+# "preserving permissions" で失敗した場合のみ -p/-a を外して再実行する(ACL/xattr は破棄)。
+REAL="$(dirname "$(readlink -f "$0")")/../../linux-x86/bin/toybox"
+out=$("$REAL" cp "$@" 2>&1); rc=$?
+case "$out" in *"preserving permissions"*)
+  args=(); end_opts=0
+  for a in "$@"; do
+    if [ $end_opts -eq 1 ]; then args+=("$a"); continue; fi
+    case "$a" in
+      --) end_opts=1; args+=("$a") ;;
+      -p|--preserve|--preserve=*) ;;
+      -a) args+=("-dR") ;;
+      --*) args+=("$a") ;;
+      -?*)
+        s="${a#-}"
+        s="${s//p/}"
+        s="${s//a/dR}"
+        [ -n "$s" ] && args+=("-$s")
+        ;;
+      *) args+=("$a") ;;
+    esac
+  done
+  "$REAL" cp "${args[@]}"
+  exit $?
+esac
+[ -n "$out" ] && printf '%s\n' "$out" >&2
+exit $rc
